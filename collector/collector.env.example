# Copy to collector.env and fill in. Keep it chmod 600.
# Keep every comment on its own line (systemd doesn't allow trailing comments).
KALSHI_KEY_ID=your-key-id-here
KALSHI_KEY_PATH=/home/ubuntu/collector/kalshi.key
DATA_DIR=/home/ubuntu/collector/data

# One process per core; SHARD is set per process by kalshi-collector@<n>.service
N_SHARDS=2
# WebSocket connections per process
N_CONN=4
# Tickers per orderbook subscription (lower if you see error 26)
CHUNK=500
# 1 = also record multivariate "combo" markets
INCLUDE_MVE=0
REFRESH_SECS=1800
ZSTD_LEVEL=1

# Optional healthchecks.io ping URLs. {shard} is replaced with 0 or 1.
HEALTHCHECK_URL=
UPLOAD_HEALTHCHECK_URL=
# Pinged after each successful deploy; DEPLOY_HEALTHCHECK_URL/fail is pinged when a deploy is rolled back.
DEPLOY_HEALTHCHECK_URL=

# Used by b2-upload.service
B2_BUCKET=gh-kalshi-raw
